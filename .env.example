# ── AI Services ──────────────────────────────────────────────────────────
# Teacher agent (Claude claude-haiku-4-5) — get at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Arabic TTS audio (OpenAI tts-1) — get at platform.openai.com
OPENAI_API_KEY=sk-...

# ── Usage Notes ───────────────────────────────────────────────────────────
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For Vercel deployment, add these as Environment Variables in:
#   Vercel Dashboard → Project → Settings → Environment Variables
#
# The app works without these keys — it falls back to:
#   • Browser SpeechSynthesis for TTS (robotic but functional)
#   • Built-in encouragement messages for teacher feedback
