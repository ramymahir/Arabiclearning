# ── AI Services ──────────────────────────────────────────────────────────
# ElevenLabs TTS — best Arabic pronunciation (eleven_multilingual_v2)
# Get at elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=sk_...

# Optional: override default voice IDs
# ELEVENLABS_VOICE_LETTER=21m00Tcm4TlvDq8ikWAM   # Rachel (letter/word audio)
# ELEVENLABS_VOICE_TEACHER=EXAVITQu4vr4xnSDxMaL  # Bella (teacher Noor voice)

# Teacher agent (Claude Haiku) — get at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Usage Notes ───────────────────────────────────────────────────────────
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For Vercel deployment, add these as Environment Variables in:
#   Vercel Dashboard → Project → Settings → Environment Variables
#
# The app works without ELEVENLABS_API_KEY — falls back to browser SpeechSynthesis.
# Without ANTHROPIC_API_KEY, built-in encouragement messages are used instead of Noor AI.
